# These OPENAI_* variables target local OpenAI-compatible endpoints such as vLLM.
# They do not require a cloud OpenAI connection.

SCRATCH_ROOT="./.runtime"
HUGGING_FACE_HUB_TOKEN=""

# Shared defaults
OPENAI_PROVIDER="openai"
OPENAI_API_KEY="dummy"
OPENAI_API_BASE="http://llama-vllm:8000/v1"
OPENAI_MODEL_NAME="llama-3.3-70b-instruct"

# Worker routing: default data/user/delivery agents
OPENAI_WORKER_PROVIDER="openai"
OPENAI_WORKER_API_KEY="dummy"
OPENAI_WORKER_API_BASE="http://llama-vllm:8000/v1"
OPENAI_WORKER_MODEL_NAME="llama-3.3-70b-instruct"

# Manager and evaluator routing: DeepSeek endpoint
OPENAI_MANAGER_PROVIDER="openai"
OPENAI_MANAGER_API_KEY="dummy"
OPENAI_MANAGER_API_BASE="http://deepseek-vllm:8000/v1"
OPENAI_MANAGER_MODEL_NAME="deepseek-r1-distill-llama-70b"

OPENAI_EVAL_PROVIDER="openai"
OPENAI_EVAL_API_KEY="dummy"
OPENAI_EVAL_API_BASE="http://deepseek-vllm:8000/v1"
OPENAI_EVAL_MODEL_NAME="deepseek-r1-distill-llama-70b"

# QA routing: defaults to the faster worker model endpoint
OPENAI_QA_PROVIDER="openai"
OPENAI_QA_API_KEY="dummy"
OPENAI_QA_API_BASE="http://llama-vllm:8000/v1"
OPENAI_QA_MODEL_NAME="llama-3.3-70b-instruct"

# Memory routing: defaults to worker endpoint unless overridden
OPENAI_MEMORY_API_KEY="dummy"
OPENAI_MEMORY_API_BASE="http://llama-vllm:8000/v1"
OPENAI_MEMORY_MODEL_NAME="llama-3.3-70b-instruct"

# DeepSeek SGLang service
DEEPSEEK_MODEL_ID="deepseek-ai/DeepSeek-R1-Distill-Llama-70B"
DEEPSEEK_HOST_PORT="8000"
DEEPSEEK_CUDA_VISIBLE_DEVICES="0,1"
DEEPSEEK_GPU_COUNT="2"
DEEPSEEK_TENSOR_PARALLEL_SIZE="2"
# 131072 can work, but is much more likely to OOM on smaller GPU counts.
DEEPSEEK_CONTEXT_LENGTH="65536"
DEEPSEEK_MEM_FRACTION_STATIC="0.93"
DEEPSEEK_CHUNKED_PREFILL_SIZE="8192"
DEEPSEEK_MAX_PREFILL_TOKENS="65536"
DEEPSEEK_MAX_RUNNING_REQUESTS="16"

# Llama 3.3 70B vLLM service
LLAMA_MODEL_ID="meta-llama/Llama-3.3-70B-Instruct"
LLAMA_HOST_PORT="8002"
LLAMA_CUDA_VISIBLE_DEVICES="2,4"
LLAMA_GPU_COUNT="2"
LLAMA_TENSOR_PARALLEL_SIZE="2"
LLAMA_MAX_MODEL_LEN="8192"
LLAMA_MAX_NUM_SEQS="32"
LLAMA_MAX_BATCHED_TOKENS="16384"
LLAMA_GPU_MEMORY_UTILIZATION="0.98"

# Memory and support services
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=""
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"
REDIS_URL="redis://redis:6379"
STAGEHAND_UI_URL="http://frontend:5173"
ENABLE_UI_QA="false"
ENABLE_CODEX_FIXER="false"
