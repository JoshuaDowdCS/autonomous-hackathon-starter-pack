FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.agents.txt .
RUN python3 -m pip install --break-system-packages --no-cache-dir -r requirements.agents.txt

COPY ui/package*.json /app/ui/
RUN cd /app/ui && npm ci

COPY . /app

RUN mkdir -p /app/logs /app/workdir

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python3", "-m", "uvicorn", "pipeline.api:app", "--host", "0.0.0.0", "--port", "8001"]
